{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.6\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"0707cf0c-0f3f-47ee-8e71-98c276f97939\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with dbt_artifacts_seeds as (\n          select\n            name,\n            unique_id,\n            database_name,\n            schema_name,\n            case when alias is not null then alias\n            else name end as table_name,\n            owner as owners,\n            tags,\n            package_name,\n            description,\n            original_path as full_path\n          from \"neondb\".\"dbt_dev_elementary\".\"dbt_seeds\"\n        )\n\n        select * from dbt_artifacts_seeds\n  \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "0707cf0c-0f3f-47ee-8e71-98c276f97939", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.6\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"0707cf0c-0f3f-47ee-8e71-98c276f97939\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with dbt_artifacts_seeds as (\n          select\n            name,\n            unique_id,\n            database_name,\n            schema_name,\n            case when alias is not null then alias\n            else name end as table_name,\n            owner as owners,\n            tags,\n            package_name,\n            description,\n            original_path as full_path\n          from \"neondb\".\"dbt_dev_elementary\".\"dbt_seeds\"\n        )\n\n        select * from dbt_artifacts_seeds\n  \n\n  ", "name": "SQLQuery", "pid": 1576, "thread": "MainThread", "ts": "2026-11-27T17:35:51.650919Z"}}
