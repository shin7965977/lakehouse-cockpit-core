{"data": {"msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"unique_id\": \"model.jaffle_governance_demo.dim_customers_dbt\", \"invocation_id\": \"f86a63f5-edc1-40c4-bc2e-3a7303bbb3ff\", \"name\": \"dim_customers_dbt\", \"schema\": \"dbt_dev_dbt_gold\", \"status\": \"success\", \"execution_time\": 0.5, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"select\\n    dbt_scd_id,\\n    customer_id,\\n    customer_name,\\n    customer_tier,\\n    region,\\n    dbt_valid_from,\\n    dbt_valid_to,\\n    (dbt_valid_to is null) as is_current\\nfrom \\\"neondb\\\".\\\"dbt_snapshots\\\".\\\"snap_customers_dbt\\\"\", \"generated_at\": \"2026-11-27 17:35:11\"}, {\"unique_id\": \"model.jaffle_governance_demo.fct_orders_dbt\", \"invocation_id\": \"f86a63f5-edc1-40c4-bc2e-3a7303bbb3ff\", \"name\": \"fct_orders_dbt\", \"schema\": \"dbt_dev_dbt_gold\", \"status\": \"success\", \"execution_time\": 0.8, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"select\\n    order_id,\\n    customer_id,\\n    order_date,\\n    to_char(order_date, 'YYYY-MM') as order_month,\\n    status,\\n    (status = 'Completed') as is_completed,\\n    order_total,\\n    case when status = 'Completed' then order_total else 0.0 end as realized_revenue,\\n    cost_total,\\n    case when status = 'Completed' then (order_total - cost_total) else 0.0 end as gross_profit\\nfrom \\\"neondb\\\".\\\"dbt_dev_dbt_silver\\\".\\\"stg_orders\\\"\", \"generated_at\": \"2026-11-27 17:35:11\"}, {\"unique_id\": \"model.jaffle_governance_demo.stg_customers\", \"invocation_id\": \"f86a63f5-edc1-40c4-bc2e-3a7303bbb3ff\", \"name\": \"stg_customers\", \"schema\": \"dbt_dev_dbt_silver\", \"status\": \"success\", \"execution_time\": 0.4, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"select\\n    cast(customer_id as integer) as customer_id,\\n    trim(customer_name) as customer_name,\\n    trim(customer_tier) as customer_tier,\\n    trim(region) as region,\\n    cast(updated_at as date) as updated_at\\nfrom \\\"neondb\\\".\\\"raw\\\".\\\"raw_customers\\\"\", \"generated_at\": \"2026-11-27 17:35:11\"}, {\"unique_id\": \"model.jaffle_governance_demo.stg_orders\", \"invocation_id\": \"f86a63f5-edc1-40c4-bc2e-3a7303bbb3ff\", \"name\": \"stg_orders\", \"schema\": \"dbt_dev_dbt_silver\", \"status\": \"success\", \"execution_time\": 0.4, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"select\\n    cast(order_id as integer) as order_id,\\n    cast(customer_id as integer) as customer_id,\\n    cast(order_date as date) as order_date,\\n    trim(status) as status,\\n    cast(order_total as double precision) as order_total,\\n    cast(cost_total as double precision) as cost_total\\nfrom \\\"neondb\\\".\\\"raw\\\".\\\"raw_orders\\\"\", \"generated_at\": \"2026-11-27 17:35:11\"}]--ELEMENTARY-MACRO-OUTPUT-END--"}, "info": {"category": "", "code": "I062", "extra": {}, "invocation_id": "4e2e20e8-40ce-4de1-81db-49ec6ce03e87", "level": "info", "msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"unique_id\": \"model.jaffle_governance_demo.dim_customers_dbt\", \"invocation_id\": \"f86a63f5-edc1-40c4-bc2e-3a7303bbb3ff\", \"name\": \"dim_customers_dbt\", \"schema\": \"dbt_dev_dbt_gold\", \"status\": \"success\", \"execution_time\": 0.5, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"select\\n    dbt_scd_id,\\n    customer_id,\\n    customer_name,\\n    customer_tier,\\n    region,\\n    dbt_valid_from,\\n    dbt_valid_to,\\n    (dbt_valid_to is null) as is_current\\nfrom \\\"neondb\\\".\\\"dbt_snapshots\\\".\\\"snap_customers_dbt\\\"\", \"generated_at\": \"2026-11-27 17:35:11\"}, {\"unique_id\": \"model.jaffle_governance_demo.fct_orders_dbt\", \"invocation_id\": \"f86a63f5-edc1-40c4-bc2e-3a7303bbb3ff\", \"name\": \"fct_orders_dbt\", \"schema\": \"dbt_dev_dbt_gold\", \"status\": \"success\", \"execution_time\": 0.8, \"full_refresh\": false, \"materialization\": \"t