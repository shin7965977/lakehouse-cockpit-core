{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.6\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\nselect\n      'neondb' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'dbt_dev_elementary'\n    union all\n    select\n      'neondb' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'dbt_dev_elementary'\n    union all\n    select\n      'neondb' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'dbt_dev_elementary'\n    union all\n    select distinct\n     'neondb' as database,\n     proname as name,\n     ns.nspname as schema,\n     'function' as type\n    from pg_proc\n     join pg_namespace as ns on pronamespace = ns.oid\n    where ns.nspname ilike 'dbt_dev_elementary'\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "7578a3be-9091-45f2-afc0-a2ead8b93559", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.6\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\nselect\n      'neondb' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'dbt_dev_elementary'\n    union all\n    select\n      'neondb' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'dbt_dev_elementary'\n    union all\n    select\n      'neondb' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'dbt_dev_elementary'\n    union all\n    select distinct\n     'neondb' as database,\n     proname as name,\n     ns.nspname as schema,\n     'function' as type\n    from pg_proc\n     join pg_namespace as ns on pronamespace = ns.oid\n    where ns.nspname ilike 'dbt_dev_elementary'\n  ", "name": "SQLQuery", "pid": 1576, "thread": "MainThread", "ts": "2026-11-27T17:35:57.611769Z"}}
